<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect root to dashboard
    RewriteRule ^$ /app/dashboard.php [L]

    # Redirect trailing slashes to non-slashed URLs
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle assets and other existing files
    RewriteCond %{REQUEST_FILENAME} -s [OR]
    RewriteCond %{REQUEST_FILENAME} -l [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^.*$ - [NC,L]

    # Route clean URLs to PHP files in the app directory
    RewriteRule ^(.*)$ app/$1.php [L]
</IfModule>
